#!/bin/bash

set -eu

prefix="__INSTALL_PREFIX__"
version="__VERSION__"
install_paths_d="__INSTALL_PATHS_D__"
release="${prefix}/versions/${version}"
current="${prefix}/current"
previous="${prefix}/previous"

[ -x "${release}/libexec/glassdock/glassdock" ] || {
    echo "The installed Glass Dock daemon is missing." >&2
    exit 1
}

old_target=$(readlink "${current}" 2>/dev/null || true)
new_target="versions/${version}"

if [ -n "${old_target}" ] && [ "${old_target}" != "${new_target}" ] \
    && [ -d "${prefix}/${old_target}" ]; then
    ln -sfn "${old_target}" "${previous}"
fi
ln -sfn "${new_target}" "${current}"

if [ "${install_paths_d}" = "1" ]; then
    mkdir -p /etc/paths.d
    printf '%s\n' "${prefix}/current/bin" > "/etc/paths.d/__PATHS_D_NAME__"
else
    rm -f "/etc/paths.d/__PATHS_D_NAME__"
fi

echo "Glass Dock ${version} is installed."
echo "Run 'glassdock enable' as your user to enable launch-on-login."
echo "Run 'glassdock restart' if a prior Glass Dock daemon is still running."
