#!/bin/bash

set -e

echo "Preparing to install glassdock..."

# Remove any existing glassdock installation to ensure clean installation
if [ -d "__INSTALL_PREFIX__" ]; then
    echo "Removing existing glassdock installation..."
    rm -rf "__INSTALL_PREFIX__"
fi

# Remove this package's existing PATH entry. This also handles reinstalling with
# PATH installation disabled after an earlier package enabled it.
if [ -f "/etc/paths.d/__PATHS_D_NAME__" ]; then
    echo "Removing existing PATH configuration..."
    rm -f "/etc/paths.d/__PATHS_D_NAME__"
fi

# Ensure the target directory exists
mkdir -p "__INSTALL_PREFIX__/bin"

echo "Pre-installation checks completed successfully."
