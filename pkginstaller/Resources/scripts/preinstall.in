#!/bin/bash

set -eu

case "$(uname -m)" in
    arm64) ;;
    *) echo "Glass Dock requires Apple Silicon." >&2; exit 1 ;;
esac

install_prefix="__INSTALL_PREFIX__"
case "${install_prefix}" in
    /opt/*) ;;
    *) echo "Refusing an unsafe installation prefix." >&2; exit 1 ;;
esac

# Do not stop the user daemon or delete the active release here. A running daemon
# can finish on its versioned files. The user restarts it after the package changes
# the current release link.
