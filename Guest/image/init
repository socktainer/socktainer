#!/bin/sh
set -eu

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t tmpfs -o mode=1777 tmpfs /tmp

: "${GLASSDOCK_GUEST_ADDRESS:?GLASSDOCK_GUEST_ADDRESS is required}"
: "${GLASSDOCK_GUEST_GATEWAY:?GLASSDOCK_GUEST_GATEWAY is required}"
: "${GLASSDOCK_GUEST_DNS:?GLASSDOCK_GUEST_DNS is required}"
ip link set dev eth0 up
ip address add "${GLASSDOCK_GUEST_ADDRESS}" dev eth0
ip route add default via "${GLASSDOCK_GUEST_GATEWAY}" dev eth0
printf 'nameserver %s\n' "${GLASSDOCK_GUEST_DNS}" > /run/resolv.conf
mount --bind /run/resolv.conf /etc/resolv.conf

host_bind_source=
excluded_host_bind_source=
expected_value=
for argument in "$@"; do
    if [ -n "${expected_value}" ]; then
        case "${expected_value}" in
            host) host_bind_source=${argument} ;;
            excluded) excluded_host_bind_source=${argument} ;;
        esac
        expected_value=
        continue
    fi
    case "${argument}" in
        --host-bind-source)
            expected_value=host
            ;;
        --host-bind-source=*)
            host_bind_source=${argument#--host-bind-source=}
            ;;
        --excluded-host-bind-source)
            expected_value=excluded
            ;;
        --excluded-host-bind-source=*)
            excluded_host_bind_source=${argument#--excluded-host-bind-source=}
            ;;
    esac
done

[ -z "${expected_value}" ] || {
    echo "guest bind option requires a path" >&2
    exit 1
}
for path in "${host_bind_source}" "${excluded_host_bind_source}"; do
    case "${path}" in
        /*) ;;
        *) echo "guest bind sources must be absolute paths" >&2; exit 1 ;;
    esac
done

mkdir -p /run/containerd
mount -t ext4 -o data=ordered /dev/vdb /var/lib/containerd
mount -t virtiofs glassdock-home /mnt/glassdock-host

containerd --config /etc/containerd/config.toml >&2 &
containerd_pid=$!

for _ in $(seq 1 3000); do
    [ -S /run/containerd/containerd.sock ] && break
    kill -0 "${containerd_pid}" 2>/dev/null || {
        exit 1
    }
    sleep 0.01
done

[ -S /run/containerd/containerd.sock ] || {
    echo "containerd did not create its socket" >&2
    exit 1
}

exec /usr/local/libexec/glassdock-guest-agent \
    --host-bind-source "${host_bind_source}" \
    --guest-bind-root /mnt/glassdock-host \
    --excluded-host-bind-source "${excluded_host_bind_source}"
